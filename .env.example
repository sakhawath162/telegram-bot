# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:replace-with-your-token

# Default timezone for new users (they can change it with /timezone)
DEFAULT_TZ=Asia/Dhaka

# /nonstop sends a storyline message every NONSTOP_MINUTES from NONSTOP_START to NONSTOP_END
NONSTOP_START=07:00
NONSTOP_END=08:00
NONSTOP_MINUTES=30
